{
  "_readme": "Payload scenarios for the POST /sabre/rules/fare endpoint (Fare Rules API).",
  "_endpoint": "POST {{URL}}/sabre/rules/fare",
  "_notes": [
    "fare_basis_code: Required. Obtained from a previous BFM search response (e.g., 'Y11BDOA').",
    "airline: Required. 2-letter IATA airline code (e.g., 'SQ').",
    "flight_number: Required. Numeric flight number as string (e.g., '447').",
    "booking_class: Required. Single letter cabin/class code (e.g., 'Y', 'N', 'B').",
    "departure_date: Required. ISO format YYYY-MM-DD.",
    "origin: Required. 3-letter IATA airport code.",
    "destination: Required. 3-letter IATA airport code.",
    "passenger_type: Optional. Defaults to 'ADT' (Adult). Use 'CNN' for child, 'INF' for infant."
  ],
