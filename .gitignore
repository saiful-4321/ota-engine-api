# ==============================================================================
# Git Ignore Configuration for ota-engine-api
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
.envrc
!.env.example
!.env.*.example

# Certificates & Secret Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Python (ota_api)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
ota_api/venv/
.pdm-python
.pdm-build/
.pixi
__pypackages__/

# Distribution / packaging / builds
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Linters, Type Checkers & Code Quality
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pypirc

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Celery
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# 3. Node.js & Webpack / Bundlers (websocket_service)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.npm
.eslintcache

# ------------------------------------------------------------------------------
# 4. Logs, Runtime Data & Databases
# ------------------------------------------------------------------------------
*.log
logs/

# API logs (keep log.txt / .gitkeep placeholder if tracked)
ota_api/log/*.log
!ota_api/log/log.txt
!ota_api/log/.gitkeep

# Mosquitto runtime storage & logs
mosquitto/data/*
!mosquitto/data/.gitkeep
mosquitto/log/*
!mosquitto/log/.gitkeep

# Local SQLite databases
*.sqlite3
*.sqlite3-journal
*.db
db.sqlite3
db.sqlite3-journal

# ------------------------------------------------------------------------------
# 5. Docker
# ------------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml
.docker/

# ------------------------------------------------------------------------------
# 6. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# 7. IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
.fleet/
*.sublime-workspace
*.sublime-project
.cursorignore
.cursorindexingignore

# VS Code (preserve shared configuration if any)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 8. Local Scratch / Ad-hoc Scripts & Heavy Devkits
# ------------------------------------------------------------------------------
# Root-level patch scripts
/patch_*.py

# Root-level ad-hoc test scripts (preserves tests inside application packages)
/test_*.py

# Heavy Postman reference devkit (22MB+ payload)
/postman/
